# Minitor environment configuration
# Copy to /etc/minitor/minitor.env (systemd) or use as a reference for Docker.

# Minitor also auto-loads a .env file (plus an optional .env.local override)
# from the current working directory at startup. Real environment variables
# always take precedence over .env values; a malformed .env logs a warning
# instead of preventing startup. Disable with --env-file "".

# HTTP listen port
# PORT=8080

# Directory for persistent data (SQLite database lives here)
DATA_DIR=/var/lib/minitor

# Set to require login; leave empty for a completely open instance
# ADMIN_PASSWORD=

# HMAC-SHA256 key for session cookies. If unset, a random key is generated
# and sessions are invalidated on restart.
# SECRET_KEY=generate-a-long-random-string

# Set to "true" to mark cookies Secure (requires HTTPS behind a reverse proxy)
# SECURE_COOKIES=false

# Number of days to retain probe results (minimum 1)
# RETENTION_DAYS=30

# SMTP alerting. All-or-nothing: if any SMTP_* is set, all five must be set.
# Omit all to disable email alerts.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=changeme
# SMTP_FROM=minitor@example.com
